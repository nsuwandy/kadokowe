# Kadokowe — environment template
# Copy to .env and fill in. Never commit .env itself.

# ---------------------------------------------------------------- database
# Neon Postgres (SRS v1.4 §13.1). Use the pooled connection string for the app
# and the direct one for migrations.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Required by `prisma migrate dev`, which replays every migration into a
# throwaway database to verify them. It must be a DIFFERENT database from
# DATABASE_URL: pointed at the same one, replaying the initial migration
# fails with `type "Availability" already exists` and no new migration can be
# created at all. The running app does not use it, and neither does
# `prisma migrate deploy` — it is a development-time requirement only.
SHADOW_DATABASE_URL="postgresql://user:password@host/dbname_shadow?sslmode=require"

# Connections per process. Prerendering runs one process per core, so the
# number that matters is this x cores. Keep it at 1 against the local
# `prisma dev` proxy (total budget ~10); raise it against a pooled production
# endpoint. Too high fails the build with P1017.
DATABASE_POOL_MAX="1"

# ---------------------------------------------------------------- media
# Cloudinary. Catalogue imagery is served through Cloudinary's own CDN rather
# than the host's image optimisation, which is the capped resource on the
# free hosting tier (SRS §13.2).
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# Unsigned upload preset, required for in-admin image upload (FR-10.10).
# Without it the image fields fall back to pasting a public ID.
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=""

# ---------------------------------------------------------------- email
# Transactional: enquiry acknowledgements and newsletter double opt-in.
RESEND_API_KEY=""
MAIL_FROM="Kadokowe <hello@example.com>"
# Where new enquiries are delivered.
ENQUIRY_NOTIFY_TO="kreasikadokowe@gmail.com"

# Newsletter provider. The subscriber list is synchronised to it but remains
# stored in our own database (FR-15.4). Campaigns are composed in the
# provider's interface, never in this admin (FR-15.6).
NEWSLETTER_PROVIDER_API_KEY=""
NEWSLETTER_LIST_ID=""

# ---------------------------------------------------------------- analytics
# Google Analytics 4 (NFR-6.5). Leave blank in development and preview
# environments — the tag only renders when this is set, which keeps their
# traffic out of the production property.
NEXT_PUBLIC_GA_ID=""

# ---------------------------------------------------------------- site
# Used for absolute URLs in emails, sitemap, hreflang and share cards.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# WhatsApp deep link target (FR-1.4). Digits only, international format.
NEXT_PUBLIC_WHATSAPP_NUMBER="628113370378"

# ---------------------------------------------------------------- admin
# Secret for admin session signing. Generate with: openssl rand -base64 32
AUTH_SECRET=""

# FR-8.7 — public link to the company profile PDF. Upload the (compressed)
# profile to Cloudinary or any host and put the URL here. Left blank, the
# download link is not shown.
NEXT_PUBLIC_COMPANY_PROFILE_URL=""

# ------------------------------------------------------- holding page
# Set to any non-empty value to show a "coming soon" page on every public
# route. The domain usually goes live before the catalogue does, and an empty
# catalogue is a worse first impression than no site at all. The admin stays
# reachable, so content can be loaded behind the curtain.
COMING_SOON=""
# A shared token that lifts the curtain: visiting /?preview=TOKEN once sets a
# cookie and the real site behaves normally thereafter. Give this to the
# client for review. It is a curtain, not access control — anyone with the
# link gets through.
COMING_SOON_BYPASS=""
