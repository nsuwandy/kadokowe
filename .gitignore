# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# prisma generated client
/src/generated/

# agent/editor tooling installed by prisma init — not project source
/.agents/
/.claude/
/.windsurf/
/skills-lock.json

# client-supplied brand files and briefs (never served statically)
/.uploads/

# Client-supplied photography originals. A shoot runs to hundreds of megabytes
# and git keeps every version forever; the delivered copies live in Cloudinary.
# See assets/README.md.
/assets/photography/*
!/assets/photography/.gitkeep
